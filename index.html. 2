                    <input id="guestName" type="text" required placeholder="Your Full Name" class="w-full bg-navy-950 border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-gold-400">
                    <input id="guestPhone" type="tel" required placeholder="Phone Number / WhatsApp" class="w-full bg-navy-950 border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-gold-400">
                    
                    <div class="space-y-2">
                        <label class="text-[11px] text-slate-400 block font-semibold">Select Attendance Option:</label>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                            <label class="cursor-pointer border border-slate-700 rounded-xl p-3 bg-navy-950 flex items-center space-x-2 hover:border-gold-400 transition">
                                <input type="radio" name="attending" value="Joyfully Attending" checked class="text-gold-400 focus:ring-0">
                                <span class="text-[11px] text-slate-200">Joyfully Attending</span>
                            </label>
                            <label class="cursor-pointer border border-slate-700 rounded-xl p-3 bg-navy-950 flex items-center space-x-2 hover:border-gold-400 transition">
                                <input type="radio" name="attending" value="Regretfully Absent" class="text-gold-400 focus:ring-0">
                                <span class="text-[11px] text-slate-200">Regretfully Absent</span>
                            </label>
                            <label class="cursor-pointer border border-slate-700 rounded-xl p-3 bg-navy-950 flex items-center space-x-2 hover:border-gold-400 transition">
                                <input type="radio" name="attending" value="Undecided" class="text-gold-400 focus:ring-0">
                                <span class="text-[11px] text-slate-200">Undecided</span>
                            </label>
                        </div>
                    </div>

                    <textarea id="guestPrayer" rows="2" placeholder="Send a Prayer Wish for Baby Boy & Parents..." class="w-full bg-navy-950 border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-gold-400"></textarea>
                </div>

                <button type="submit" class="w-full py-3 bg-gradient-to-r from-gold-300 via-gold-400 to-gold-600 hover:from-gold-200 hover:to-gold-500 text-navy-950 font-black text-xs uppercase tracking-widest rounded-xl transition shadow-lg">
                    Submit RSVP Confirmation
                </button>
            </form>
        </section>

        <!-- Prayer Wall -->
        <section class="glass-card rounded-3xl p-6 sm:p-8 space-y-4">
            <div class="text-center space-y-1">
                <h2 class="text-xl font-bold font-cinzel text-white">Prayer Wall & Blessings</h2>
                <p class="text-xs text-slate-400">Prayers and wishes sent by loved ones</p>
            </div>

            <div id="prayerWallContainer" class="space-y-3 max-h-60 overflow-y-auto pr-1"></div>
        </section>

    </main>

    <!-- Promotional Footer -->
    <footer class="w-full max-w-xl mx-auto text-center py-8 border-t border-slate-800/80 space-y-3">
        <p class="text-xs text-slate-400 leading-relaxed max-w-md mx-auto">
            For all your digital invitations for Weddings, Naming ceremonies, Corporate Programmes, kindly contact 
            <a href="mailto:admin@lordblessconsultancy.com" class="text-gold-300 font-semibold underline hover:text-gold-200">admin@lordblessconsultancy.com</a> 
            or visit 
            <a href="https://www.lordblessconsultancy.com" target="_blank" class="text-gold-300 font-semibold underline hover:text-gold-200">www.lordblessconsultancy.com</a>.
        </p>
        <button onclick="promptAdmin()" class="text-[10px] text-slate-600 hover:text-gold-300 transition">
            <i class="fas fa-lock mr-1"></i> Host Admin Console
        </button>
    </footer>

    <!-- JavaScript Audio & Interactive Engine -->
    <script>
        let audioCtx = null;
        let isPlaying = false;
        let melodyInterval = null;
        let autoAudioInitialized = false;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playTone(freq, duration) {
            if (!audioCtx || audioCtx.state === 'suspended') return;
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch(e){}
        }

        function playMillionMiraclesMelody() {
            const notes = [261.63, 329.63, 392.00, 523.25, 440.00, 392.00, 329.63];
            let idx = 0;
            melodyInterval = setInterval(() => {
                if (isPlaying) {
                    playTone(notes[idx], 0.6);
                    idx = (idx + 1) % notes.length;
                }
            }, 500);
        }

        function enableAudioOnInteraction() {
            if (!autoAudioInitialized) {
                autoAudioInitialized = true;
                initAudio();
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                if (!isPlaying) {
                    isPlaying = true;
                    playMillionMiraclesMelody();
                    document.getElementById('audioIcon').className = "fas fa-pause text-sm text-gold-300";
                    document.getElementById('eqVisualizer').classList.remove('opacity-40');
                }
            }
        }

        function toggleAudio(e) {
            if (e) e.stopPropagation();
            initAudio();
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            const icon = document.getElementById('audioIcon');
            const eq = document.getElementById('eqVisualizer');

            if (!isPlaying) {
                isPlaying = true;
                playMillionMiraclesMelody();
                icon.className = "fas fa-pause text-sm text-gold-300";
                eq.classList.remove('opacity-40');
            } else {
                isPlaying = false;
                clearInterval(melodyInterval);
                icon.className = "fas fa-music text-sm text-gold-300";
                eq.classList.add('opacity-40');
            }
        }

        // Scratch Seal Engine
        const canvas = document.getElementById('scratchCanvas');
        const ctx = canvas.getContext('2d');
        let isScratching = false;

        function setupCanvas() {
            const size = window.innerWidth >= 640 ? 320 : 290;
            canvas.width = size;
            canvas.height = size;

            const grad = ctx.createLinearGradient(0, 0, size, size);
            grad.addColorStop(0, '#f7e2a3');
            grad.addColorStop(0.5, '#d4af37');
            grad.addColorStop(1, '#8a6207');

            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.arc(size / 2, size / 2, size / 2, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#02050b';
            ctx.font = 'bold 15px Cinzel, serif';
            ctx.textAlign = 'center';
            ctx.fillText('SCRATCH TO REVEAL', size / 2, (size / 2) - 8);
            ctx.font = '11px Plus Jakarta Sans, sans-serif';
            ctx.fillText('✨ ROYAL SEAL ✨', size / 2, (size / 2) + 16);
        }

        function scratch(e) {
            if (!isScratching) return;
            const rect = canvas.getBoundingClientRect();
            const x = (e.clientX || (e.touches && e.touches[0].clientX)) - rect.left;
            const y = (e.clientY || (e.touches && e.touches[0].clientY)) - rect.top;

            ctx.globalCompositeOperation = 'destination-out';
            ctx.beginPath();
            ctx.arc(x, y, 25, 0, Math.PI * 2);
            ctx.fill();

            checkScratchPercentage();
        }

        function checkScratchPercentage() {
            const size = canvas.width;
            const imageData = ctx.getImageData(0, 0, size, size);
            const pixels = imageData.data;
            let clearPixels = 0;

            for (let i = 3; i < pixels.length; i += 4) {
                if (pixels[i] === 0) clearPixels++;
            }

            const percentage = (clearPixels / (pixels.length / 4)) * 100;
            if (percentage > 35) {
                confetti({
                    particleCount: 80,
                    spread: 70,
                    origin: { y: 0.6 },
                    colors: ['#d4af37', '#0284c7', '#ffffff']
                });
                canvas.style.pointerEvents = 'none';
                canvas.style.opacity = '0';
                document.getElementById('scratchInstructions').innerText = "✨ Seal Unveiled Successfully! ✨";
            }
        }

        canvas.addEventListener('mousedown', () => isScratching = true);
        canvas.addEventListener('mouseup', () => isScratching = false);
        canvas.addEventListener('mousemove', scratch);

        canvas.addEventListener('touchstart', () => isScratching = true);
        canvas.addEventListener('touchend', () => isScratching = false);
        canvas.addEventListener('touchmove', scratch);

        // Countdown Timer
        const eventDate = new Date('November 1, 2026 08:30:00 GMT').getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const diff = eventDate - now;

            if (diff > 0) {
                document.getElementById('cdDays').innerText = Math.floor(diff / (1000 * 60 * 60 * 24)).toString().padStart(2, '0');
                document.getElementById('cdHours').innerText = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)).toString().padStart(2, '0');
                document.getElementById('cdMins').innerText = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60)).toString().padStart(2, '0');
                document.getElementById('cdSecs').innerText = Math.floor((diff % (1000 * 60)) / 1000).toString().padStart(2, '0');
            }
        }
        setInterval(updateCountdown, 1000);
        updateCountdown();

        // Vote Board
        let nameVotes = { "Ethan": 14, "Ethaniel": 8, "Nathan": 6, "Solomon": 4 };

        function renderVotes() {
            const board = document.getElementById('voteBoard');
            board.innerHTML = '';
            const total = Object.values(nameVotes).reduce((a, b) => a + b, 0);

            Object.entries(nameVotes).forEach(([name, count]) => {
                const pct = Math.round((count / total) * 100);
                const row = document.createElement('div');
                row.className = "space-y-1";
                row.innerHTML = `
                    <div class="flex justify-between text-[11px]">
                        <span class="text-white font-semibold">${name}</span>
                        <span class="text-gold-300 font-mono">${count} votes (${pct}%)</span>
                    </div>
                    <div class="w-full h-1.5 bg-navy-950 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-gold-400 to-gold-200 rounded-full" style="width: ${pct}%"></div>
                    </div>
                `;
                board.appendChild(row);
            });
        }

        function submitGuess() {
            const val = document.getElementById('guessInput').value.trim();
            if (!val) return;

            const capitalized = val.charAt(0).toUpperCase() + val.slice(1).toLowerCase();
            nameVotes[capitalized] = (nameVotes[capitalized] || 0) + 1;
            renderVotes();

            confetti({ particleCount: 40, spread: 50, origin: { y: 0.7 } });
            const fb = document.getElementById('guessFeedback');
            fb.innerText = `✨ Thank you! Your vote for "${capitalized}" has been recorded on the live board.`;
            fb.classList.remove('hidden');
            document.getElementById('guessInput').value = '';
        }

        // Copy MoMo
        function copyMoMo() {
            const num = document.getElementById('momoNum').innerText;
            navigator.clipboard.writeText(num);
            alert("MTN Mobile Money Number copied: " + num);
        }

        // RSVP & Prayer Wall
        const defaultPrayers = [
            { name: "Auntie Mary & Family", wish: "May the Lord bless and keep the new baby boy in Jesus' name!" },
            { name: "Deacon Samuel", wish: "Congratulations Mr. & Mrs. Aware! God's grace abounds." }
        ];

        function getStoredRSVPs() {
            const stored = localStorage.getItem('aware_baby_rsvps');
            return stored ? JSON.parse(stored) : defaultPrayers;
        }

        function renderPrayerWall() {
            const container = document.getElementById('prayerWallContainer');
            const items = getStoredRSVPs();
            container.innerHTML = '';

            items.forEach(item => {
                const div = document.createElement('div');
                div.className = "bg-navy-900/60 p-3 rounded-xl border border-slate-700/50 space-y-1";
                div.innerHTML = `
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold text-gold-300">${item.name}</span>
                        <span class="text-[9px] text-slate-500">Blessing</span>
                    </div>
                    <p class="text-xs text-slate-300 italic">"${item.wish}"</p>
                `;
                container.appendChild(div);
            });
        }

        function handleRSVPSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('guestName').value.trim();
            const phone = document.getElementById('guestPhone').value.trim();
            const attending = document.querySelector('input[name="attending"]:checked').value;
            const wish = document.getElementById('guestPrayer').value.trim() || "God bless baby boy and the Aware family!";

            const newRSVP = { name, phone, attending, wish };
            const currentList = getStoredRSVPs();
            currentList.unshift(newRSVP);

            localStorage.setItem('aware_baby_rsvps', JSON.stringify(currentList));
            renderPrayerWall();

            confetti({ particleCount: 60, spread: 60, origin: { y: 0.8 } });
            alert(`Thank you ${name}! Your RSVP confirmation has been received.`);
            document.getElementById('rsvpForm').reset();
        }

        // Admin Console
        function promptAdmin() {
            const pin = prompt("Enter Host Passcode:");
            if (pin === "2026" || pin === "1234") {
                const list = getStoredRSVPs();
                let msg = "--- HOST RSVP GUEST LIST ---\n\n";
                list.forEach((r, i) => {
                    msg += `${i+1}. ${r.name} (${r.phone}) - ${r.attending}\n   Wish: ${r.wish}\n\n`;
                });
                alert(msg);
            } else if (pin !== null) {
                alert("Incorrect Passcode.");
            }
        }

        setupCanvas();
        renderVotes();
        renderPrayerWall();
    </script>
</body>
